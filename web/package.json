{
  "name": "agentpay-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build:sdk": "corepack pnpm --recursive --filter '@agentpay/server' --filter '@agentpay/client' run build",
    "predev": "corepack pnpm run build:sdk",
    "dev": "next dev",
    "prebuild": "corepack pnpm run build:sdk",
    "build": "next build",
    "start": "next start",
    "pretypecheck": "corepack pnpm run build:sdk",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:production": "node scripts/verify-production.mjs",
    "demo:premium": "tsx --env-file=.env.local examples/premium-client.ts"
  },
  "dependencies": {
    "@agentpay/client": "workspace:*",
    "@agentpay/server": "workspace:*",
    "@coinbase/x402": "~2.1.0",
    "@x402/core": "~2.22.0",
    "@x402/extensions": "~2.22.0",
    "@x402/next": "~2.22.0",
    "express": "5.2.1",
    "lucide-react": "1.31.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "redis": "6.2.0",
    "viem": "2.55.10"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "30.0.1",
    "tsx": "4.23.4",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
