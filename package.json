{
  "name": "x402-usdc-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": { "node": ">=20.9" },
  "scripts": {
    "build": "corepack pnpm --dir web build",
    "typecheck": "corepack pnpm --recursive --filter './packages/*' run typecheck && tsc -p tsconfig.json && corepack pnpm --dir web typecheck",
    "test": "vitest run && corepack pnpm --dir web test",
    "lint": "corepack pnpm --dir web lint",
    "test:e2e": "corepack pnpm --dir web test:e2e",
    "dev:web": "corepack pnpm --dir web dev",
    "smoke:preview": "tsx scripts/smoke/x402-mainnet.ts",
    "smoke:mainnet": "tsx scripts/smoke/x402-mainnet.ts --execute"
  },
  "dependencies": {
    "@x402/core": "2.22.0",
    "@x402/evm": "2.22.0",
    "@x402/fetch": "2.22.0",
    "viem": "2.55.10"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
